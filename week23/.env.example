# LangChain 学习环境配置模板
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# ---------- 方案 A：云端 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / OpenAI 等）----------
# 注意：DeepSeek 等服务只要兼容 OpenAI 协议，就能用 ChatOpenAI 直接调用
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 单次回复的输出上限（token），防止模型长篇大论烧钱
OPENAI_MAX_TOKENS=1024

# ---------- 模型来源开关 ----------
# openai = 云端（按 token 计费）  ollama = 本地（免费）  qwen = 千问（计费）
LLM_PROVIDER=openai

# ---------- 千问（阿里云百炼 OpenAI 兼容模式）----------
# 控制台：https://bailian.console.aliyun.com → API-KEY 管理
# 课堂专用网关：https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1 + qwen3.8-flash
# 官方百炼：下面这个地址 + qwen-plus / qwen-max / qwen-turbo
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 千问思考模式：true = 先输出推理再回答（慢、贵、易被 max_tokens 截断）
QWEN_ENABLE_THINKING=false

# ---------- 方案 B：本地 Ollama ----------
# 本机已装 Ollama，默认监听 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b

# ---------- 可选：LangSmith 追踪（免费额度足够学习）----------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=langchain-learning
